; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bit & Bloom"
run/main_scene="res://scenes/village.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GuestSession="*res://scripts/guest_session.gd"
DialogScriptManager="*res://scripts/dialog_script_manager.gd"
DialogueManager="*uid://c3rodes2l3gxb"
MCPRuntime="*uid://b6nuyl4g3wafy"

[dialogue_manager]

runtime/balloon_path="res://scenes/ui/cozy_dialogue_balloon.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/auto_reload/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_mcp_editor/plugin.cfg", "res://addons/godot_mcp_runtime/plugin.cfg")

[gui]

theme/custom_font="res://font/Moneygraphy-Pixel.ttf"

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogue/generated/arrival.dialogue", "res://dialogue/generated/npc_clip.dialogue", "res://dialogue/generated/npc_nut.dialogue", "res://dialogue/generated/npc_pin.dialogue", "res://dialogue/generated/npc_screw.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.24, 0.29, 0.21, 1)
